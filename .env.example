# Copy to .env and fill in. .env is gitignored; this file is committed.

# --- required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- where the agency APIs live ---
# config.json stores endpoints as "${GOV_API_BASE}/dukcapil/getNIK". This is
# the only place the mock-government host is written down. Point it at a
# deployed instance to move off localhost; no code or config.json edits.
GOV_API_BASE=http://localhost:9001

# --- this server ---
HOST=127.0.0.1
PORT=8000

# --- the permit form (separate repo, separate origin) ---
# GET /permit redirects here. Leave blank to disable the route.
PERMIT_URL=http://localhost:8080

# Origins allowed to call /api/*. Comma-separated, or * to allow all.
# The permit form runs on its own origin, so it must be listed here.
CORS_ORIGINS=http://localhost:8080
